PORT=4000
# The web app's URL. Comma-separate several (e.g. localhost plus a tunnel URL).
CLIENT_ORIGIN=http://localhost:3000
# The server's address as browsers see it (images the AI draws are served from here).
# Defaults to http://localhost:PORT. Set it to the LAN IP, tunnel, or deployed URL when the host screen isn't on this machine.
PUBLIC_URL=
# With a key the real Gemini pipeline runs; without one, the fake AI does.
GEMINI_API_KEY=
# Optional. Defaults: gemini-flash-latest, gemini-3.1-flash-image
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=
DATABASE_URL=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
DEMO_MODE=false
