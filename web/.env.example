# Copy to web/.env. Restart `npm run dev` after changing it.

# The game server's address. Without it, the pages show built-in sample data.
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Optional: hosts sign in with Auth0 before starting a game (players never sign in).
# Leave these empty to skip sign-in. From your Auth0 application's Settings tab
# (type: Regular Web Application). Make a secret with: openssl rand -hex 32
# In the Auth0 app's Settings, allow:
#   Callback URLs: http://localhost:3000/auth/callback, https://*.trycloudflare.com/auth/callback
#   Logout URLs:   http://localhost:3000, https://*.trycloudflare.com
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
