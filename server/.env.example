PORT=4000
# The web app's URL. Comma-separate several (e.g. localhost plus a tunnel URL).
CLIENT_ORIGIN=http://localhost:3000
# The server's address as browsers see it. Target images and the AI's drawings are served from here.
# Defaults to http://localhost:PORT, which only works on this machine: as soon as phones join,
# set it to the same address as the web app's NEXT_PUBLIC_SERVER_URL (LAN IP, tunnel, or deployed URL).
# Otherwise the describer's phone can't load the target image.
PUBLIC_URL=
# With a key the real Gemini pipeline runs; without one, the fake AI does.
# Free keys have a small daily limit. List several, comma-separated (each from its own Google
# Cloud project), and when one runs out the next takes over: GEMINI_API_KEY=key1,key2,key3
GEMINI_API_KEY=
# Or use Gemini through Google Cloud's Vertex AI, billed to the project's Cloud billing account
# (free-trial credits apply there) instead of an AI Studio key. Overrides GEMINI_API_KEY.
# Needs the Vertex AI API enabled in the project, and `gcloud auth application-default login`.
VERTEX_PROJECT=
VERTEX_LOCATION=global
# Optional. Defaults: gemini-flash-latest, gemini-flash-lite-latest, gemini-3.1-flash-image
# The free tier allows about 20 requests a day per model, so transcription gets its own model
# (it falls back to GEMINI_TEXT_MODEL if that one is missing or out of quota).
GEMINI_TEXT_MODEL=
GEMINI_TRANSCRIBE_MODEL=
GEMINI_IMAGE_MODEL=
# Left empty, the Gemini image model draws (it needs billing; Vertex AI credits work), and Pollinations,
# a free service with no key, takes over if it fails. Set to "pollinations" to draw with Pollinations only,
# e.g. on the free tier; Gemini still transcribes, scores, and writes captions.
IMAGE_PROVIDER=
# Optional, for IMAGE_PROVIDER=pollinations: a free token from auth.pollinations.ai raises its rate limit.
POLLINATIONS_TOKEN=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
