PORT=4000
# The web app's URL. Comma-separate several (e.g. localhost plus a tunnel URL).
CLIENT_ORIGIN=http://localhost:3000
# The server's address as browsers see it. Target images and the AI's drawings are served from here.
# Defaults to http://localhost:PORT, which only works on this machine: as soon as phones join,
# set it to the same address as the web app's NEXT_PUBLIC_SERVER_URL (LAN IP, tunnel, or deployed URL).
# Otherwise the describer's phone can't load the target image.
PUBLIC_URL=
# With a key the real Gemini pipeline runs; without one, the fake AI does.
GEMINI_API_KEY=
# Optional. Defaults: gemini-flash-latest, gemini-3.1-flash-image
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=
# The Gemini image model needs billing. Set to "pollinations" to draw with a free service instead
# (no key needed); Gemini still transcribes, scores, and writes captions.
IMAGE_PROVIDER=
# Optional, for IMAGE_PROVIDER=pollinations: a free token from auth.pollinations.ai raises its rate limit.
POLLINATIONS_TOKEN=
DATABASE_URL=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
DEMO_MODE=false
